    },
    "Highlight": "https://your.name/kg/Highlight",
    "highlightText": "https://your.name/kg/highlightText",
    "Entity": "https://your.name/kg/Entity",
    "prefLabel": "http://www.w3.org/2004/02/skos/core#prefLabel",
